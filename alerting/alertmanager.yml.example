# Starting point only. It validates as it stands, and it sends nothing.
#
# You do not edit this file by hand. Add contacts in the app, under
# "Who gets told", and xxOps rewrites this whole file -- route and receivers --
# from what you entered there. Anything you hand-edit is overwritten the next
# time you save a contact.
#
# Until then everything routes to a receiver that does nothing, which is the
# honest default: alerts are evaluated and visible in the app, and nothing is
# delivered anywhere until you have said where to deliver it.

global:
  resolve_timeout: 5m

route:
  receiver: quiet
  group_by: ['alertname']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: quiet
